// ------------------------------------------------------------------
// Sensus Pajak - skema database (MySQL 8)
// Nama tabel & kolom dipetakan ke snake_case agar sama dengan DDL rujukan.
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Akun admin (satu-satunya peran yang boleh menyusun bank formulir).
model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique(map: "admin_username_key") @db.VarChar(64)
  passwordHash String @map("password_hash") @db.VarChar(255)
  /// Dinaikkan setiap password diganti; token dengan versi lama langsung ditolak.
  tokenVersi   Int    @default(0) @map("token_versi")

  @@map("admin")
}

/// Petugas pendata. Menjadi sumber dropdown tim petugas pada kertas kerja.
model Petugas {
  id        Int      @id @default(autoincrement())
  nama      String   @db.VarChar(150)
  nip       String   @default("") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at")
  /// Akun login, dibuatkan admin. Null = belum punya akun (belum bisa masuk).
  /// Disimpan huruf kecil; MySQL membolehkan banyak NULL pada indeks unik.
  username      String?   @unique(map: "petugas_username_key") @db.VarChar(64)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  /// Dinaikkan saat password diganti, akun dihapus, atau admin mengeluarkan
  /// petugas dari semua HP: token dengan versi lama langsung ditolak.
  tokenVersi    Int       @default(0) @map("token_versi")
  masukTerakhir DateTime? @map("masuk_terakhir")

  kertasKerja KertasKerjaPetugas[]

  @@map("petugas")
}

/// Akun pejabat (pimpinan): hanya melihat kertas kerja, data, dan peta.
/// Server menolak setiap permintaan tulis dari akun ini (src/auth.js
/// tolakTulisPejabat). Dibuatkan admin dari halaman Petugas; bukan petugas,
/// jadi tidak muncul di pilihan tim kertas kerja.
model Pejabat {
  id            Int       @id @default(autoincrement())
  /// Nama atau jabatan yang tampil di aplikasi, mis. "Kepala Bapenda".
  nama          String    @db.VarChar(150)
  /// Disimpan huruf kecil; tidak boleh sama dengan username admin atau petugas.
  username      String    @unique(map: "pejabat_username_key") @db.VarChar(64)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  /// Dinaikkan saat password diganti atau admin mengeluarkan akun ini dari
  /// semua perangkat: token dengan versi lama langsung ditolak.
  tokenVersi    Int       @default(0) @map("token_versi")
  masukTerakhir DateTime? @map("masuk_terakhir")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("pejabat")
}

/// Pengaturan aplikasi yang diubah admin dari layar. Satu baris saja (id = 1).
model Pengaturan {
  id                Int     @id
  /// true = semua API (kecuali login) menolak pemakai yang belum masuk.
  /// Dinyalakan admin setelah akun petugas siap, bukan otomatis saat deploy.
  wajibLoginPetugas Boolean @default(false) @map("wajib_login_petugas")

  @@map("pengaturan")
}

/// Lapisan peta dari aplikasi GIS (QGIS / ArcGIS), mis. batas blok PBB atau
/// persil, yang digambar di atas Peta Sensus. Diunggah admin sebagai GeoJSON
/// EPSG:4326 (src/lapisanPeta.js). Isinya tidak pernah diubah: mengganti berkas
/// = hapus lalu unggah ulang, jadi id + createdAt cukup sebagai versi cache.
model LapisanPeta {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(100)
  /// Warna garis dan isian, "#RRGGBB".
  warna       String   @default("#2563EB") @db.VarChar(7)
  /// true = langsung menyala saat Peta Sensus dibuka; tiap pemakai tetap bisa mematikannya.
  tampil      Boolean  @default(true)
  /// FeatureCollection yang sudah dirapikan (koordinat 6 desimal, tanpa Z).
  /// Paling besar 12 MB: batas paket MariaDB bawaan (max_allowed_packet) 16 MB.
  isi         String   @db.LongText
  jumlahFitur Int      @map("jumlah_fitur")
  /// Ukuran `isi` dalam byte.
  ukuran      Int
  /// Username admin yang mengunggah.
  dibuatOleh  String   @default("") @map("dibuat_oleh") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("lapisan_peta")
}

/// Bidang tanah (persil) dari peta pendaftaran BPN, diimpor admin dari
/// shapefile (client/src/lib/shapefile.js membaca dan mengubah koordinatnya ke
/// WGS 84 di browser; server/src/persil.js memeriksa dan menyimpannya).
///
/// Peta Sensus memuatnya per petak (sel_lat / sel_lon, lihat persil.js), bukan
/// sekaligus: satu kota berisi ratusan ribu bidang.
///
/// Impor baru tersembunyi (aktif = false) sampai seluruh berkasnya terkirim,
/// lalu menggantikan bidang lama di kelurahan yang sama (kunci_wilayah).
model Persil {
  id           Int      @id @default(autoincrement())
  /// NIB seperti di berkas BPN, mis. "03612" - unik per kelurahan, bukan se-kota.
  nib          String   @default("") @db.VarChar(30)
  /// Kode wilayah BPN 8 digit, mis. "17117402". Kode + NIB = NIB lengkap.
  kodeWilayah  String   @default("") @map("kode_wilayah") @db.VarChar(20)
  kecamatan    String   @default("") @db.VarChar(100)
  kelurahan    String   @default("") @db.VarChar(100)
  tipeHak      String   @default("") @map("tipe_hak") @db.VarChar(60)
  /// Luas menurut peta BPN (m²).
  luasPeta     Float?   @map("luas_peta")
  /// Atribut lain dari berkasnya (objek JSON), untuk balon peta.
  atribut      String   @db.Text
  /// Geometri GeoJSON (Polygon / MultiPolygon), derajat WGS 84, 6 desimal.
  geometri     String   @db.MediumText
  /// Kotak pembatas geometri.
  minLat       Float    @map("min_lat")
  minLon       Float    @map("min_lon")
  maxLat       Float    @map("max_lat")
  maxLon       Float    @map("max_lon")
  /// Petak tempat sudut barat daya kotaknya: floor(min / UKURAN_PETAK).
  selLat       Int      @map("sel_lat")
  selLon       Int      @map("sel_lon")
  /// Kotaknya lebih lebar / tinggi dari satu petak: dicari tanpa sel_*.
  besar        Boolean  @default(false)
  /// Impor ulang menggantikan seluruh bidang dengan kunci yang sama:
  /// "kode:<kode wilayah>", atau "nama:<kecamatan>|<kelurahan>" bila tanpa kode.
  kunciWilayah String   @map("kunci_wilayah") @db.VarChar(250)
  /// Token impor yang membawanya.
  impor        String   @db.VarChar(24)
  /// false = impornya belum selesai; tidak tampil di mana pun.
  aktif        Boolean  @default(false)
  /// Username admin yang mengimpor.
  dibuatOleh   String   @default("") @map("dibuat_oleh") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([aktif, besar, selLat, selLon], map: "persil_petak_idx")
  @@index([aktif, kunciWilayah], map: "persil_wilayah_idx")
  @@index([nib], map: "persil_nib_idx")
  /// Mencocokkan NIB yang dicatat sensus (entri_nib) dengan bidangnya.
  @@index([aktif, kodeWilayah, nib], map: "persil_kode_nib_idx")
  @@index([impor], map: "persil_impor_idx")
  @@map("persil")
}

/// Bank formulir. Setiap formulir dapat diisi berkali-kali di dalam kertas kerja.
model Formulir {
  id        Int      @id @default(autoincrement())
  judul     String   @db.VarChar(200)
  deskripsi String?  @db.Text
  /// Nama ikon (mis. "store") yang tampil di kartu formulir; kosong = nomor urut.
  ikon      String   @default("") @db.VarChar(40)
  /// Judul di atas kolom kiri / kanan halaman isi data (mis. "Subjek Pajak" / "Objek Pajak").
  judulKolomKiri  String @default("") @map("judul_kolom_kiri") @db.VarChar(100)
  judulKolomKanan String @default("") @map("judul_kolom_kanan") @db.VarChar(100)
  /// Data boleh disimpan walau isian wajib masih kosong, asalkan ditandai
  /// "Berkas tidak lengkap" - pertanyaan Lokasi (koordinat) tetap wajib.
  /// Untuk formulir seperti PBB-P2 yang dokumennya sering belum ada di lapangan.
  simpanBerkasKurang Boolean @default(false) @map("simpan_berkas_kurang")
  /// Urutan tampil di bank formulir - diatur admin lewat seret (drag & drop).
  urutan    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  pertanyaan Pertanyaan[]
  entri      Entri[]

  @@map("formulir")
}

enum TipePertanyaan {
  text
  paragraph
  number
  date
  dropdown
  radio
  checkbox
  range
  linetariff
  foto
  wilayah
  lokasi
  rtrw
  nik
  npwp
  nop
  niknpwp
  telepon
  luas
  nib
}

/// Satu pertanyaan di dalam sebuah formulir.
model Pertanyaan {
  id         Int            @id @default(autoincrement())
  formulirId Int            @map("formulir_id")
  tipe       TipePertanyaan
  label      String         @db.VarChar(300)
  /// Petunjuk pengisian, tampil di bawah judul pertanyaan.
  keterangan String         @default("") @db.VarChar(500)
  wajib      Boolean        @default(false)
  /// Khusus tipe "linetariff": izinkan harga rentang per baris.
  rangeHarga Boolean        @default(false) @map("range_harga")
  /// Isi otomatis dari data EPBB saat petugas mengonfirmasi hasil cek NOP (mis. "nama_wp"). Kosong = tidak.
  isiEpbb    String         @default("") @map("isi_epbb") @db.VarChar(30)
  /// Posisi di halaman isi data: "" = lebar penuh, "kiri" / "kanan" = dua kolom bersanding.
  kolom      String         @default("") @db.VarChar(10)
  urutan     Int            @default(0)

  formulir     Formulir         @relation(fields: [formulirId], references: [id], onDelete: Cascade)
  opsi         PertanyaanOpsi[]
  jawaban      Jawaban[]
  rincianTarif RincianTarif[]
  foto         Foto[]
  entriNib     EntriNib[]

  @@index([formulirId], map: "pertanyaan_formulir_id_idx")
  @@map("pertanyaan")
}

/// Opsi untuk dropdown / radio / checkbox, dan daftar "Jenis tarif" untuk linetariff.
model PertanyaanOpsi {
  id           Int    @id @default(autoincrement())
  pertanyaanId Int    @map("pertanyaan_id")
  nilai        String @db.VarChar(200)
  urutan       Int    @default(0)

  pertanyaan Pertanyaan @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)

  @@index([pertanyaanId], map: "pertanyaan_opsi_pertanyaan_id_idx")
  @@map("pertanyaan_opsi")
}

enum StatusKertasKerja {
  draft
  selesai
}

/// Kertas kerja: satu nomor, dikerjakan satu tim petugas, berisi banyak data.
model KertasKerja {
  id        Int               @id @default(autoincrement())
  nomor     String            @unique(map: "kertas_kerja_nomor_key") @db.Char(5)
  /// Judul yang diketik petugas saat membuat - dipakai sebagai identitas di daftar.
  judul     String            @default("") @db.VarChar(200)
  status    StatusKertasKerja @default(draft)
  createdAt DateTime          @default(now()) @map("created_at")
  /// TIDAK DIPAKAI LAGI (titik_* sampai lokasi_dicek_oleh): sisa fitur "lokasi
  /// sensus" per kertas kerja yang dihapus 2026-11-04. Kolomnya dibiarkan supaya
  /// isian lama tetap ada; aplikasi tidak lagi membaca atau menulisnya.
  ///
  /// Dulu: titik rumah / bidang yang disensus. "peta" = ditunjuk di peta atau
  /// ditempel dari Google Maps, "gps" = Rekam di sini di lokasi, "data" = GPS
  /// terbaik datanya yang dibekukan saat admin menandai sudah dicek.
  titikLat      Float?    @map("titik_lat")
  titikLon      Float?    @map("titik_lon")
  titikAkurasi  Float?    @map("titik_akurasi")
  titikSumber   String    @default("") @map("titik_sumber") @db.VarChar(10)
  titikWaktu    DateTime? @map("titik_waktu")
  /// Username admin yang menetapkan, atau "petugas" bila tanpa login.
  titikOleh     String    @default("") @map("titik_oleh") @db.VarChar(64)
  /// Dulu: hasil pemeriksaan lokasi (baik | tanpa | kantor | kasar) untuk saringan
  /// "Lokasi perlu dicek". Tidak lagi dihitung.
  lokasiStatus  String?   @map("lokasi_status") @db.VarChar(10)
  /// Dulu: lokasi sensus sudah dicek admin.
  lokasiDicekAt   DateTime? @map("lokasi_dicek_at")
  lokasiDicekOleh String    @default("") @map("lokasi_dicek_oleh") @db.VarChar(64)

  petugas        KertasKerjaPetugas[]
  entri          Entri[]
  pengajuanHapus PengajuanHapus[]

  @@index([lokasiStatus], map: "kertas_kerja_lokasi_status_idx")
  @@map("kertas_kerja")
}

/// Tim petugas sebuah kertas kerja (1-8 orang). Urutan 0 = penanggung jawab.
model KertasKerjaPetugas {
  id            Int @id @default(autoincrement())
  kertasKerjaId Int @map("kertas_kerja_id")
  petugasId     Int @map("petugas_id")
  urutan        Int @default(0)

  kertasKerja KertasKerja @relation(fields: [kertasKerjaId], references: [id], onDelete: Cascade)
  petugas     Petugas     @relation(fields: [petugasId], references: [id], onDelete: Restrict)

  @@unique([kertasKerjaId, petugasId], map: "kertas_kerja_petugas_unik")
  @@index([petugasId], map: "kertas_kerja_petugas_petugas_id_idx")
  @@map("kertas_kerja_petugas")
}

/// Satu data yang diisi lewat satu formulir di dalam kertas kerja.
/// Formulir yang sama boleh diisi berkali-kali (mis. beberapa objek).
model Entri {
  id            Int      @id @default(autoincrement())
  kertasKerjaId Int      @map("kertas_kerja_id")
  formulirId    Int      @map("formulir_id")
  /// false = berkas pendukung (mis. KTP, SPPT) belum lengkap; ditandai petugas agar mudah dicari.
  berkasLengkap Boolean  @default(true) @map("berkas_lengkap")
  /// Apa saja yang masih kurang. Dikosongkan bila berkas ditandai lengkap.
  catatanBerkas String   @default("") @map("catatan_berkas") @db.VarChar(500)
  /// Koordinat perangkat petugas saat data ini pertama kali disimpan, diambil
  /// otomatis tanpa pertanyaan di formulir. Null bila izin lokasi ditolak atau
  /// GPS gagal - pendataan sengaja tidak dihalangi oleh urusan GPS.
  /// Terbuka untuk semua pemakai aplikasi, bukan admin saja: sejak titik peta
  /// hanya bersumber dari koordinat rekaman, membatasinya ke admin membuat
  /// halaman Peta Sensus kosong bagi petugas.
  rekamLat      Float?    @map("rekam_lat")
  rekamLon      Float?    @map("rekam_lon")
  /// Perkiraan simpangan dalam meter, apa adanya dari perangkat.
  rekamAkurasi  Float?    @map("rekam_akurasi")
  rekamWaktu    DateTime? @map("rekam_waktu")
  /// Koordinat objek (jawaban pertanyaan Lokasi) sudah dicek admin: terkunci,
  /// petugas tidak bisa mengubahnya lagi.
  koordinatDicekAt   DateTime? @map("koordinat_dicek_at")
  koordinatDicekOleh String    @default("") @map("koordinat_dicek_oleh") @db.VarChar(64)
  /// Nama petugas (atau username admin) yang menyimpan / terakhir mengubah data.
  /// Kosong = disimpan tanpa login, sebelum login petugas diwajibkan.
  dibuatOleh    String   @default("") @map("dibuat_oleh") @db.VarChar(150)
  diubahOleh    String   @default("") @map("diubah_oleh") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  kertasKerja    KertasKerja      @relation(fields: [kertasKerjaId], references: [id], onDelete: Cascade)
  formulir       Formulir         @relation(fields: [formulirId], references: [id], onDelete: Cascade)
  jawaban        Jawaban[]
  rincianTarif   RincianTarif[]
  foto           Foto[]
  pengajuanHapus PengajuanHapus[]
  entriNib       EntriNib[]

  @@index([kertasKerjaId], map: "entri_kertas_kerja_id_idx")
  @@index([formulirId], map: "entri_formulir_id_idx")
  @@index([berkasLengkap], map: "entri_berkas_lengkap_idx")
  /// Peta admin menyaring entri yang punya koordinat rekaman.
  @@index([rekamLat], map: "entri_rekam_lat_idx")
  @@map("entri")
}

/// Jawaban satu pertanyaan pada satu entri. Bentuk JSON per tipe pertanyaan:
///   text/paragraph/number/date/dropdown/radio : string
///   checkbox                                  : array string
///   range                                     : { min, max }
///   linetariff                                : array { layanan, jenis, harga_min, harga_max }
///   foto                                      : array { id, nama }
///   wilayah                                   : { kecamatan, kode_kecamatan, kelurahan, kode_kelurahan[, manual] }
///   lokasi                                    : { lat, lon, akurasi, ketinggian, waktu }
///   rtrw                                      : { rt, rw }  (masing-masing 3 digit)
///   nik / npwp / nop                          : string digit (16 / 15-17 / 18 digit)
///   niknpwp                                   : { nik, npwp }  (minimal salah satu bila wajib)
///   telepon                                   : array { keterangan, nomor }  (nomor 8-15 digit)
///   luas                                      : { tanah, bangunan }  (m², number|null)
///   nib                                       : { bidang: [{ kode, nib, sumber, diPeta, tipeHak, luas, kelurahan, kecamatan }], status }
model Jawaban {
  id           Int  @id @default(autoincrement())
  entriId      Int  @map("entri_id")
  pertanyaanId Int  @map("pertanyaan_id")
  nilai        Json
  /// Diisi otomatis dari data EPBB (hasil cek NOP) dan belum diubah petugas.
  dariEpbb     Boolean @default(false) @map("dari_epbb")

  entri      Entri      @relation(fields: [entriId], references: [id], onDelete: Cascade)
  pertanyaan Pertanyaan @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)

  @@unique([entriId, pertanyaanId], map: "jawaban_entri_id_pertanyaan_id_key")
  @@index([pertanyaanId], map: "jawaban_pertanyaan_id_idx")
  @@map("jawaban")
}

/// Bentuk ternormalisasi dari jawaban "linetariff" - memudahkan pelaporan/agregasi.
/// Ditulis ulang setiap kali entri disimpan.
model RincianTarif {
  id           Int      @id @default(autoincrement())
  entriId      Int      @map("entri_id")
  pertanyaanId Int      @map("pertanyaan_id")
  layanan      String   @db.VarChar(200)
  jenis        String   @default("") @db.VarChar(100)
  hargaMin     Decimal? @map("harga_min") @db.Decimal(18, 2)
  hargaMax     Decimal? @map("harga_max") @db.Decimal(18, 2)
  urutan       Int      @default(0)

  entri      Entri      @relation(fields: [entriId], references: [id], onDelete: Cascade)
  pertanyaan Pertanyaan @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)

  @@index([entriId], map: "rincian_tarif_entri_id_idx")
  @@index([pertanyaanId], map: "rincian_tarif_pertanyaan_id_idx")
  @@map("rincian_tarif")
}

/// Bentuk ternormalisasi dari jawaban "nib" (Bidang Tanah BPN): satu baris per
/// bidang yang dicatat petugas, bersama NOP data itu. Dipakai untuk mencocokkan
/// NIB dengan NOP di seluruh data (src/integrasi.js): bidang mana yang sudah
/// punya NOP, NOP mana yang menempati beberapa bidang, dan sebaliknya.
/// Ditulis ulang setiap kali entri disimpan, seperti rincian_tarif.
model EntriNib {
  id           Int    @id @default(autoincrement())
  entriId      Int    @map("entri_id")
  pertanyaanId Int    @map("pertanyaan_id")
  /// Kode wilayah BPN 8 digit, mis. "17117402" - kosong bila tidak diketahui.
  kodeWilayah  String @default("") @map("kode_wilayah") @db.VarChar(20)
  /// NIB 5 digit, mis. "03612".
  nib          String @db.VarChar(30)
  /// NOP data ini (18 digit) saat disimpan; kosong = data tanpa NOP.
  nop          String @default("") @db.VarChar(18)
  /// "peta" = dipilih di peta, "sertifikat" = diketik dari sertifikat.
  sumber       String @default("") @db.VarChar(12)
  /// Luas peta BPN saat dicatat (m²).
  luasPeta     Float? @map("luas_peta")
  urutan       Int    @default(0)

  entri      Entri      @relation(fields: [entriId], references: [id], onDelete: Cascade)
  pertanyaan Pertanyaan @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)

  @@index([kodeWilayah, nib], map: "entri_nib_kunci_idx")
  @@index([nop], map: "entri_nib_nop_idx")
  @@index([entriId], map: "entri_nib_entri_id_idx")
  @@index([pertanyaanId], map: "entri_nib_pertanyaan_id_idx")
  @@map("entri_nib")
}

/// NOP PBB yang dicatat langsung pada bidang BPN dari Peta Sensus (tab NOP di
/// panel bidang), tanpa formulir. Bersama entri_nib membentuk lapisan NOP PBB:
/// pasangan NIB-NOP, boleh banyak-ke-banyak (src/integrasi.js). Dikunci kode
/// wilayah + NIB, bukan id persil: id persil berganti setiap impor ulang.
model BidangNop {
  id          Int      @id @default(autoincrement())
  /// Kode wilayah BPN 8 digit, mis. "17117402" - kosong bila berkas BPN-nya tanpa kode.
  kodeWilayah String   @default("") @map("kode_wilayah") @db.VarChar(20)
  /// NIB 5 digit, mis. "03612".
  nib         String   @db.VarChar(30)
  /// NOP 18 digit.
  nop         String   @db.VarChar(18)
  /// Keterangan opsional, mis. "sebagian bidang", "rumah susun".
  keterangan  String   @default("") @db.VarChar(200)
  /// Yang menambahkan: peran ("admin" | "petugas"), id akunnya, dan namanya saat itu.
  olehPeran   String   @default("") @map("oleh_peran") @db.VarChar(10)
  olehId      Int?     @map("oleh_id")
  olehNama    String   @default("") @map("oleh_nama") @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([kodeWilayah, nib, nop], map: "bidang_nop_unik")
  @@index([nop], map: "bidang_nop_nop_idx")
  @@map("bidang_nop")
}

/// Keputusan pemadanan satu bidang BPN dengan NOP-nya (lapisan Terintegrasi,
/// src/integrasi.js susunTerpadu). Satu baris per bidang; diputuskan ulang = ditimpa.
/// Keputusan tidak berlaku lagi bila sesudahnya ada NOP baru di bidang itu.
model PadananBidang {
  id          Int      @id @default(autoincrement())
  kodeWilayah String   @default("") @map("kode_wilayah") @db.VarChar(20)
  nib         String   @db.VarChar(30)
  /// "padan" (satu NOP untuk bidang ini) | "pecah" (semua NOP sah, menunggu dipecah) | "tanpa" (NOP-nya bukan untuk bidang ini)
  hasil       String   @db.VarChar(10)
  /// NOP bidang ini (hasil "padan"), 18 digit; kosong untuk hasil lain.
  nopUtama    String   @default("") @map("nop_utama") @db.VarChar(18)
  /// Setiap NOP di bidang saat diputuskan: [{ nop, tindak, luasPbb, luasBeda }]
  /// tindak: utama | ganda | gabung | salah_bidang | sah. luasBeda: luas PBB perlu disesuaikan ke BPN.
  rincian     Json
  catatan     String   @default("") @db.VarChar(200)
  /// Yang memutuskan: peran ("admin" | "petugas"), id akunnya, dan namanya saat itu.
  olehPeran   String   @default("") @map("oleh_peran") @db.VarChar(10)
  olehId      Int?     @map("oleh_id")
  olehNama    String   @default("") @map("oleh_nama") @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([kodeWilayah, nib], map: "padanan_bidang_unik")
  @@map("padanan_bidang")
}

/// Berkas foto yang diunggah. entri_id masih NULL selama foto baru diunggah
/// dan entrinya belum disimpan; foto yatim dibersihkan otomatis.
model Foto {
  id           Int      @id @default(autoincrement())
  entriId      Int?     @map("entri_id")
  pertanyaanId Int?     @map("pertanyaan_id")
  /// Path relatif terhadap UPLOAD_DIR, mis. "2026/09/1757750000-ab12cd.jpg".
  berkas       String   @unique(map: "foto_berkas_key") @db.VarChar(200)
  namaAsli     String   @default("") @map("nama_asli") @db.VarChar(200)
  mime         String   @db.VarChar(40)
  ukuran       Int
  createdAt    DateTime @default(now()) @map("created_at")

  entri      Entri?      @relation(fields: [entriId], references: [id], onDelete: Cascade)
  pertanyaan Pertanyaan? @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)

  @@index([entriId], map: "foto_entri_id_idx")
  @@index([pertanyaanId], map: "foto_pertanyaan_id_idx")
  @@map("foto")
}

enum JenisPengajuan {
  kertas_kerja
  entri
}

enum StatusPengajuan {
  menunggu
  disetujui
  ditolak
}

/// Permintaan petugas agar admin menghapus sebuah kertas kerja atau satu data.
/// Petugas tidak login, jadi `pengaju` hanyalah nama anggota tim yang dipilih
/// saat mengajukan.
///
/// Baris tetap disimpan setelah diputuskan sebagai jejak. Tautannya menjadi NULL
/// begitu sasarannya terhapus, karena itu nomor kertas kerja dan judul data
/// disalin ke sini supaya riwayatnya tetap terbaca.
model PengajuanHapus {
  id             Int             @id @default(autoincrement())
  jenis          JenisPengajuan
  /// Untuk jenis "entri" diisi kertas kerja pemilik datanya.
  kertasKerjaId  Int?            @map("kertas_kerja_id")
  entriId        Int?            @map("entri_id")
  nomorKk        String          @map("nomor_kk") @db.Char(5)
  /// Jenis "entri": judul data dan formulirnya, mis. "Toko Budi · PBJT Restoran".
  judul          String          @default("") @db.VarChar(300)
  alasan         String          @db.VarChar(500)
  pengaju        String          @db.VarChar(150)
  status         StatusPengajuan @default(menunggu)
  createdAt      DateTime        @default(now()) @map("created_at")
  diputuskanAt   DateTime?       @map("diputuskan_at")
  /// Username admin yang memutuskan.
  diputuskanOleh String          @default("") @map("diputuskan_oleh") @db.VarChar(64)

  kertasKerja KertasKerja? @relation(fields: [kertasKerjaId], references: [id], onDelete: SetNull)
  entri       Entri?       @relation(fields: [entriId], references: [id], onDelete: SetNull)

  @@index([status], map: "pengajuan_hapus_status_idx")
  @@index([kertasKerjaId], map: "pengajuan_hapus_kertas_kerja_id_idx")
  @@index([entriId], map: "pengajuan_hapus_entri_id_idx")
  @@map("pengajuan_hapus")
}

/// Counter penomoran kertas kerja - selalu tepat 1 baris (id = 1).
model NomorCounter {
  id        Int @id @default(1)
  lastNomor Int @default(0) @map("last_nomor")
  /// Naik setiap kali seluruh kertas kerja di-reset; browser membuang draf dari periode lain.
  periode   Int @default(0)

  @@map("nomor_counter")
}
