# ------------------------------------------------------------------
# Sensus Pajak - contoh environment. Salin menjadi .env lalu sesuaikan.
# ------------------------------------------------------------------

# Koneksi MySQL 8.
# Lokal  : mysql://root:password@localhost:3306/formkita
# Railway: referensikan variabel MySQL Railway, mis.
#          mysql://${{MySQL.MYSQLUSER}}:${{MySQL.MYSQL_ROOT_PASSWORD}}@${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}
DATABASE_URL="mysql://root:password@localhost:3306/formkita"

# Rahasia penandatangan JWT. WAJIB diganti di produksi (string acak panjang).
JWT_SECRET="ganti-dengan-string-acak-yang-panjang"

# Masa berlaku token admin.
JWT_EXPIRES_IN="12h"

# Akun admin yang di-seed otomatis saat server pertama kali start.
# WAJIB diganti sebelum deploy: di produksi server MENOLAK START bila akun admin
# belum ada dan ADMIN_PASSWORD masih kosong, terlalu pendek (< 8 karakter), atau
# masih bernilai contoh seperti "admin123". Setelah akunnya ada, passwordnya
# diubah lewat halaman Akun dan nilai di sini tidak dipakai lagi.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-yang-kuat"

# Port HTTP. Railway meng-inject PORT secara otomatis - jangan di-hardcode di produksi.
PORT=4000

# Folder penyimpanan foto. Kosongkan untuk memakai ./uploads di root repo.
# Railway: pasang Volume lalu arahkan ke mount path-nya, mis. /app/uploads.
UPLOAD_DIR=
# Batas ukuran satu foto (MB). Foto diperkecil di browser sebelum diunggah.
UPLOAD_MAX_MB=8
# Zona waktu untuk kolom "Waktu input" pada ekspor CSV.
APP_TIMEZONE="Asia/Makassar"

# Alamat publik aplikasi, mis. https://sensus.banjarbarukota.go.id (tanpa garis
# miring di akhir). Dipakai menyusun tautan foto di berkas ekspor. Bila kosong,
# alamatnya diambil dari header Host permintaan - yang bisa dipalsukan pengirim,
# jadi sebaiknya diisi di produksi.
APP_URL=

# Cek NOP ke EPBB (baca-saja). Kosongkan salah satunya untuk mematikan tombol "Lihat".
# URL endpoint api/nop/cek milik EPBB, tanpa garis miring di akhir.
EPBB_API_URL=
# Sama dengan $config['api_nop_key'] di application/config/api_nop.php EPBB.
EPBB_API_KEY=
# Batas tunggu respons EPBB (milidetik).
EPBB_TIMEOUT_MS=10000

# Isi data contoh (formulir, petugas) saat start pertama bila database masih kosong.
# Biarkan false di produksi - berkas ini sering tersalin apa adanya ke server.
SEED_DEMO=false

# Asal frontend saat pengembangan lokal (CORS). Kosongkan di produksi (satu origin).
CORS_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------
# Kode akses petugas (opsional, sangat disarankan bila aplikasi terbuka
# ke internet).
#
# Pekerjaan lapangan sengaja tidak memakai akun, sehingga tanpa kode ini
# SIAPA PUN yang tahu alamat aplikasi bisa membaca dan mengubah seluruh data
# sensus - termasuk NIK, NPWP, nomor telepon, alamat, foto, dan titik koordinat
# rumah wajib pajak.
#
# Diisi  : seluruh /api butuh kode ini (atau token admin). Petugas memasukkannya
#          sekali per perangkat, lalu tersimpan sebagai cookie 30 hari.
# Kosong : aplikasi terbuka untuk umum, persis seperti sebelumnya.
#
# Minimal 6 karakter; mengganti nilainya membatalkan semua cookie yang beredar.
AKSES_KODE=
